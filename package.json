{
  "name": "@cityofzion/onesig",
  "version": "0.1.0",
  "description": "One signature → a self-custodied session wallet (viem account). Deterministic, zero-infra, EOA-only.",
  "keywords": [
    "ethereum",
    "evm",
    "neo-x",
    "wallet",
    "session-key",
    "agent",
    "viem",
    "deterministic",
    "signature"
  ],
  "license": "MIT",
  "author": "City of Zion",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CityOfZion/onesig.git"
  },
  "homepage": "https://github.com/CityOfZion/onesig#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "viem": "^2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "viem": "^2.21.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
